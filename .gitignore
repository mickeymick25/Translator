# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual environments ────────────────────────────────
venv/
ENV/
env/
.venv/

# ─── Tests & Coverage ───────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ─── Pre-commit ──────────────────────────────────────────
.pre-commit-cache/

# ─── Docker ──────────────────────────────────────────────
.dockerignore

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*

# ─── Logs ────────────────────────────────────────────────
*.log
logs/

# ─── DONNÉES — Ne pas committer ─────────────────────────
# Sources : tout fichier de données métier (toutes extensions)
translator/source/**
!translator/source/.gitkeep
# Outputs : tout fichier généré (les artefacts recette délibérément
# suivis — Analytics/*.tsv, checklist/recette md — restent suivis :
# gitignore n'affecte pas les fichiers déjà trackés)
translator/output/**
!translator/output/.gitkeep
!translator/output/**/

# Formats Apple égarés (fuite 17/06 : .numbers non couvert par json/xlsx/csv)
**/*.numbers
**/*.key

# Cache de traductions et state du rate limiter
**/.translation_cache.json
**/.rate_limiter_state.json

# ─── Backups — Ne pas committer ─────────────────────────
*.bak*
*.legacy_backup
translator/output/**/backup/
