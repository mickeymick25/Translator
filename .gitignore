.dockerignore

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*

# ─── Logs ────────────────────────────────────────────────
*.log
logs/

# ─── DONNÉES — Ne pas committer ─────────────────────────
# Sources : fichiers de données métier (toutes extensions)
translator/source/**/*.json
translator/source/**/*.xlsx
translator/source/**/*.xls
translator/source/**/*.csv

# Outputs : fichiers générés (toutes extensions)
translator/output/**/*.json
translator/output/**/*.xlsx
translator/output/**/*.xls
translator/output/**/*.csv

# Cache de traductions et state du rate limiter
**/.translation_cache.json
**/.rate_limiter_state.json

# ─── Backups — Ne pas committer ─────────────────────────
*.bak*
*.legacy_backup
translator/output/**/backup/
